{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: up sqlserver",
      "type": "shell",
      "command": "\"C:/Program Files/Docker/Docker/resources/bin/docker.exe\" compose --env-file .env -f docker-compose.yml up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "app: run with docker sql",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run-dev.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}