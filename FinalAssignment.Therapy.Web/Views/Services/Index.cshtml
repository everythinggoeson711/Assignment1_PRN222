@model IEnumerable<FinalAssignment.Therapy.Core.Entities.TherapyService>
@{
    ViewData["Title"] = "Our Services";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="text-primary fw-bold text-uppercase tracking-wide">Therapy Options</span>
        <h1 class="display-4 fw-bold mt-2">Find the Right Support for You</h1>
        <p class="lead text-muted mx-auto mt-3" style="max-width: 600px;">
            Explore our range of evidence-based psychological services designed to help you navigate life's challenges.
        </p>
    </div>

    <!-- Category Filter -->
    <div class="d-flex justify-content-center gap-2 mb-5 flex-wrap">
        <a asp-action="Index" asp-route-category="" class="btn @(string.IsNullOrEmpty(selectedCategory) ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">All Services</a>
        @foreach (var cat in categories)
        {
            <a asp-action="Index" asp-route-category="@cat" class="btn @(selectedCategory == cat ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">@cat</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var service in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden" style="transition: transform 0.3s; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    @if (!string.IsNullOrEmpty(service.ImageUrl))
                    {
                        <img src="@service.ImageUrl" class="card-img-top" alt="@service.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fas fa-heartbeat fa-3x text-primary opacity-50"></i>
                        </div>
                    }
                    <div class="card-body p-4">
                        <span class="badge bg-primary bg-opacity-10 text-primary mb-2">@service.Category</span>
                        <h4 class="card-title fw-bold mb-3">@service.Name</h4>
                        <p class="card-text text-muted mb-4 line-clamp-3">@service.Description</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                            <div>
                                <h5 class="mb-0 fw-bold text-primary">@service.Price.ToString("N0") VND</h5>
                                <small class="text-muted"><i class="far fa-clock me-1"></i> @service.DurationMinutes mins</small>
                            </div>
                            <a asp-action="Details" asp-route-id="@service.Id" class="btn btn-primary rounded-circle" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
