@model IEnumerable<FinalAssignment.Therapy.Application.Models.AppointmentSummaryDto>
@{
    ViewData["Title"] = "Manage Appointments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="section-heading mb-4 d-flex justify-content-between align-items-end gap-3 flex-wrap">
    <div>
        <span class="eyebrow">Admin / Appointments</span>
        <h1>Booked Sessions</h1>
        <p>Monitor all therapist bookings, confirm payments, and manage appointment statuses.</p>
    </div>
    <div class="input-group" style="max-width: 300px;">
        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
        <input type="text" id="appointmentSearch" class="form-control border-start-0 ps-0" placeholder="Search bookings...">
    </div>
</section>

<section class="glass-panel dashboard-table">
    <div class="table-responsive">
        <table class="table align-middle mb-0" id="appointmentsTable">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Therapist</th>
                    <th>Service</th>
                    <th>Date & Time</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model)
                {
                    <tr>
                        <td>
                            <strong>@appt.PatientName</strong>
                            <div class="small text-secondary">@appt.PatientEmail</div>
                            <div class="small text-muted">Ref: @appt.TrackingCode</div>
                        </td>
                        <td>@appt.TherapistName</td>
                        <td>@appt.ServiceName</td>
                        <td>
                            <div class="fw-bold">@appt.AppointmentStartUtc.ToLocalTime().ToString("MMM dd, yyyy")</div>
                            <div class="small text-secondary">@appt.AppointmentStartUtc.ToLocalTime().ToString("HH:mm")</div>
                        </td>
                        <td>
                            <span class="status-badge status-@GetAppointmentStatusClass(appt.Status).Replace(" text-dark", "")">@appt.Status</span>
                        </td>
                        <td>
                            <span class="status-badge status-@GetPaymentStatusClass(appt.PaymentStatus).Replace(" text-dark", "")">@appt.PaymentStatus</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                @if (appt.PaymentStatus == FinalAssignment.Therapy.Core.Enums.PaymentStatus.Pending)
                                {
                                    <form asp-action="ConfirmPayment" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appt.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3" title="Confirm Payment">Confirm Pay</button>
                                    </form>
                                }
                                <a class="btn btn-sm btn-outline-light rounded-pill px-3" href="#">Details</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@functions {
    string GetAppointmentStatusClass(FinalAssignment.Therapy.Core.Enums.AppointmentStatus status)
    {
        return status switch
        {
            FinalAssignment.Therapy.Core.Enums.AppointmentStatus.Confirmed => "success",
            FinalAssignment.Therapy.Core.Enums.AppointmentStatus.PendingPayment => "warning text-dark",
            FinalAssignment.Therapy.Core.Enums.AppointmentStatus.Cancelled => "danger",
            FinalAssignment.Therapy.Core.Enums.AppointmentStatus.Completed => "info text-dark",
            FinalAssignment.Therapy.Core.Enums.AppointmentStatus.Expired => "secondary",
            _ => "light text-dark"
        };
    }

    string GetPaymentStatusClass(FinalAssignment.Therapy.Core.Enums.PaymentStatus status)
    {
        return status switch
        {
            FinalAssignment.Therapy.Core.Enums.PaymentStatus.Paid => "success",
            FinalAssignment.Therapy.Core.Enums.PaymentStatus.Pending => "warning text-dark",
            FinalAssignment.Therapy.Core.Enums.PaymentStatus.Refunded => "info text-dark",
            FinalAssignment.Therapy.Core.Enums.PaymentStatus.Failed => "danger",
            FinalAssignment.Therapy.Core.Enums.PaymentStatus.Expired => "secondary",
            _ => "light text-dark"
        };
    }
}

@section Scripts {
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() {
            var table = $('#appointmentsTable').DataTable({
                "order": [[ 3, "desc" ]],
                "dom": "lrtip" // Hide default search bar
            });

            $('#appointmentSearch').on('keyup', function() {
                table.search(this.value).draw();
            });
        });
    </script>
}
