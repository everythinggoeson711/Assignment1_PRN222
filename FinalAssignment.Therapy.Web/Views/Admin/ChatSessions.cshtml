@model List<FinalAssignment.Therapy.Core.Entities.ChatSession>
@{
    ViewData["Title"] = "Chat Sessions Management";
}

<section class="section-heading mb-4">
    <div class="d-flex justify-content-between align-items-center w-100">
        <div>
            <span class="eyebrow">Admin / Chat Support</span>
            <h1>Live Chat Sessions</h1>
            <p>Quản lý tất cả các phiên chat hỗ trợ khách hàng đang hoạt động.</p>
        </div>
        <div>
            @if (Model.Any())
            {
                <form method="post" asp-action="ClearAllSessions" onsubmit="return confirm('🚨 Xóa tất cả sessions? Dùng để test 2 tab ẩn danh riêng biệt.');" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-warning btn-sm">
                        🧪 Clear All Sessions (Testing)
                    </button>
                </form>
            }
        </div>
    </div>
</section>

<section class="metrics-grid mb-4">
    <article class="stats-card">
        <span class="eyebrow">Active Sessions</span>
        <span class="metric-value">@Model.Count</span>
    </article>
    <article class="stats-card">
        <span class="eyebrow">Waiting for Staff</span>
        <span class="metric-value">@Model.Count(s => s.AssignedStaffId == null)</span>
    </article>
</section>

<section class="glass-panel dashboard-table">
    <div class="section-heading mb-3">
        <span class="eyebrow">Chat Inbox</span>
        <h2>Active Sessions Queue</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3 text-secondary"><i class="fas fa-inbox fa-3x"></i></div>
            <h5 class="text-secondary">Không có phiên chat nào đang hoạt động</h5>
            <p class="text-muted">Các phiên chat sẽ hiển thị ở đây khi khách hàng bắt đầu trò chuyện.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Started At</th>
                        <th>Status</th>
                        <th>Assigned Staff</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.OrderByDescending(s => s.StartedAt))
                    {
                        bool isWaiting = session.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.WaitingForStaff;
                        <tr>
                            <td>
                                <strong>@(session.CustomerName ?? "Unknown")</strong>
                                @if (!string.IsNullOrEmpty(session.CustomerEmail))
                                {
                                    <div class="small text-secondary">@session.CustomerEmail</div>
                                }
                            </td>
                            <td>@session.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (isWaiting)
                                {
                                    <span class="status-badge" style="background: #fff3cd; color: #856404;">Waiting</span>
                                }
                                else if (session.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.Active)
                                {
                                    <span class="status-badge" style="background: #cff4fc; color: #055160;">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge">Ended</span>
                                }
                            </td>
                            <td>
                                @if (session.AssignedStaff != null)
                                {
                                    <span class="text-success fw-bold">@session.AssignedStaff.FullName</span>
                                }
                                else
                                {
                                    <span class="text-warning fw-bold">Unassigned</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("ChatSession", new { sessionId = session.SessionId })" 
                                       class="btn btn-sm btn-primary">
                                        @(isWaiting ? "Join Chat" : "View")
                                    </a>
                                    @if (session.IsActive)
                                    {
                                        <form asp-action="EndChatSession" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sessionId" value="@session.SessionId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                    onclick="return confirm('Are you sure you want to end this chat session?')">
                                                End
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .build();

        connection.start().then(() => {
            console.log("Connected to ChatHub");
            connection.invoke("JoinAsStaff");
        });

        // Listen for new chat sessions
        connection.on("NewChatSession", (sessionInfo) => {
            location.reload();
        });

        // Listen for assigned sessions
        connection.on("SessionAssigned", (sessionId) => {
            location.reload();
        });
    </script>
}