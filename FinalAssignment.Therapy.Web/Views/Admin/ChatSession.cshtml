@model FinalAssignment.Therapy.Core.Entities.ChatSession
@{
    ViewData["Title"] = $"Chat Session - {Model.CustomerName}";
    var messages = ViewBag.Messages as List<FinalAssignment.Therapy.Core.Entities.ChatMessage> ?? new List<FinalAssignment.Therapy.Core.Entities.ChatMessage>();
}

<section class="section-heading mb-4">
    <span class="eyebrow">Admin / Chat Support</span>
    <h1>Chat Session with @(Model.CustomerName ?? "Unknown Customer")</h1>
    <div class="d-flex gap-3 align-items-center">
        <p class="mb-0">Started: @Model.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        <span class="status-badge @(Model.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.WaitingForStaff ? "status-warning" : "status-success")">
            @(Model.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.WaitingForStaff ? "Waiting" : 
              Model.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.Active ? "Active" : "Ended")
        </span>
    </div>
</section>

<div class="row">
    <div class="col-md-8">
        <section class="glass-panel">
            <div class="section-heading mb-3">
                <span class="eyebrow">Live Chat</span>
                <h2>Conversation</h2>
            </div>

            <div class="chat-container border rounded p-3 bg-light mb-3" style="height: 500px; overflow-y: scroll;">
                <ul id="messagesList" class="list-unstyled">
                    @foreach (var message in messages)
                    {
                        <li class="mb-3 pb-2 border-bottom">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong class="@(message.IsFromStaff ? "text-primary" : "text-dark")">
                                        @message.SenderName @(message.IsFromStaff ? "(Staff)" : "(Customer)")
                                    </strong>
                                    <p class="mb-1">@message.Message</p>
                                </div>
                                <small class="text-muted">@message.SentAt.ToLocalTime().ToString("HH:mm")</small>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            @if (Model.IsActive)
            {
                <div class="row">
                    @if (Model.AssignedStaffId == null)
                    {
                        <div class="col-12 mb-3">
                            <button id="assignToMe" class="btn btn-success w-100">
                                Assign This Session to Me
                            </button>
                        </div>
                    }
                    
                    <div class="col-12">
                        <div class="input-group">
                            <input type="text" id="messageInput" class="form-control" placeholder="Type your message..." @(Model.AssignedStaffId == null ? "disabled" : "") />
                            <button class="btn btn-primary" id="sendButton" @(Model.AssignedStaffId == null ? "disabled" : "")>Send</button>
                        </div>
                        <div class="mt-2">
                            <button id="forceJoinGroup" class="btn btn-sm btn-warning">🔄 Force Join Group</button>
                            <small class="text-muted">Click if messages not updating</small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    This chat session has ended.
                </div>
            }
        </section>
    </div>
    
    <div class="col-md-4">
        <section class="glass-panel">
            <div class="section-heading mb-3">
                <span class="eyebrow">Session Details</span>
                <h3>Information</h3>
            </div>
            
            <table class="table table-borderless">
                <tr>
                    <td><strong>Session ID:</strong></td>
                    <td>@Model.SessionId</td>
                </tr>
                <tr>
                    <td><strong>Customer:</strong></td>
                    <td>@(Model.CustomerName ?? "Unknown")</td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                {
                    <tr>
                        <td><strong>Email:</strong></td>
                        <td>@Model.CustomerEmail</td>
                    </tr>
                }
                <tr>
                    <td><strong>Status:</strong></td>
                    <td>@Model.Status</td>
                </tr>
                <tr>
                    <td><strong>Started:</strong></td>
                    <td>@Model.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>
                @if (Model.EndedAt.HasValue)
                {
                    <tr>
                        <td><strong>Ended:</strong></td>
                        <td>@Model.EndedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                }
                @if (Model.AssignedStaff != null)
                {
                    <tr>
                        <td><strong>Assigned Staff:</strong></td>
                        <td>@Model.AssignedStaff.FullName</td>
                    </tr>
                }
            </table>

            <div class="mt-3">
                <a href="@Url.Action("ChatSessions")" class="btn btn-outline-secondary w-100 mb-2">
                    ← Back to All Sessions
                </a>
                @if (Model.IsActive)
                {
                    <form asp-action="EndChatSession" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionId" value="@Model.SessionId" />
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to end this chat session?')">
                            End Session
                        </button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const sessionId = "@Model.SessionId";
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .configureLogging(signalR.LogLevel.Information)
            .withAutomaticReconnect()
            .build();

        console.log("Admin SignalR Connection State:", connection.state);

        document.getElementById("sendButton").disabled = true;

        connection.on("GroupTest", (message) => {
            console.log("Admin Group test received:", message);
            // This confirms admin is in the SignalR group
        });

        connection.on("ReceiveMessage", (messageData) => {
            console.log('Admin ReceiveMessage:', messageData);
            
            // Defensive programming - check for undefined/null values
            const sender = messageData.sender || 'Unknown';
            const message = messageData.message || '[Empty message]';
            const timestamp = messageData.timestamp || new Date().toLocaleTimeString();
            const isFromStaff = messageData.isFromStaff || false;
            
            const li = document.createElement("li");
            li.className = "mb-3 p-3 border-bottom bg-light rounded";
            
            const senderClass = isFromStaff ? "text-primary fw-bold" : "text-success fw-bold";
            const senderRole = isFromStaff ? "(Staff)" : "(Customer)";
            
            try {
                li.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="${senderClass}">${sender} ${senderRole}</div>
                            <div class="mt-2 text-dark" style="font-size: 14px; line-height: 1.4;">${message}</div>
                        </div>
                        <small class="text-muted ms-2">${timestamp}</small>
                    </div>
                `;
                
                const messagesList = document.getElementById("messagesList");
                if (messagesList) {
                    messagesList.appendChild(li);
                    console.log('Admin message added to DOM successfully');
                } else {
                    console.error('Admin messagesList element not found');
                }
                
                const container = document.querySelector('.chat-container');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            } catch (err) {
                console.error('Error in admin ReceiveMessage:', err);
            }
        });

        connection.start().then(() => {
            console.log("Admin Connected to ChatHub");
            document.getElementById("sendButton").disabled = false;
            
            // Join AdminStaff group first
            connection.invoke("JoinAsStaff");
            
            // ALWAYS join this specific session group regardless of assignment status
            connection.invoke("JoinSessionGroup", sessionId).then(() => {
                console.log(`Admin FORCE joined session group: ${sessionId}`);
                
                // Send a test message to confirm group membership
                setTimeout(() => {
                    connection.invoke("JoinSessionGroup", sessionId);
                    console.log("Double-checked group membership");
                }, 1000);
                
                // Auto-assign if not assigned yet
                @if (Model.AssignedStaffId == null)
                {
                    <text>
                    setTimeout(() => {
                        console.log("Auto-assigning session to current admin...");
                        connection.invoke("AssignToSession", sessionId);
                    }, 2000);
                    </text>
                }
            }).catch(err => {
                console.error("Error joining session group:", err);
            });
        }).catch(err => {
            console.error("SignalR connection failed:", err);
        });

        // Handle reconnection
        connection.onreconnected(() => {
            console.log("SignalR reconnected, rejoining groups...");
            connection.invoke("JoinAsStaff");
            connection.invoke("JoinSessionGroup", sessionId);
        });

        connection.onclose(() => {
            console.log("SignalR connection closed");
        });

        // Assign session to current user
        document.getElementById("assignToMe")?.addEventListener("click", async () => {
            console.log("Assigning session to me:", sessionId);
            try {
                await connection.invoke("AssignToSession", sessionId);
                console.log("Session assigned successfully");
                location.reload(); // Refresh to update UI
            } catch (err) {
                console.error("Error assigning session:", err);
                alert("Could not assign session. Please try again.");
            }
        });

        // Force join group button
        document.getElementById("forceJoinGroup").addEventListener("click", () => {
            console.log("Force joining group...");
            connection.invoke("JoinSessionGroup", sessionId).then(() => {
                console.log("Force join successful");
                alert("Force joined group! Try sending a message from customer.");
            }).catch(err => {
                console.error("Force join failed:", err);
                alert("Force join failed: " + err.toString());
            });
        });

        // Send message
        document.getElementById("sendButton").addEventListener("click", sendMessage);
        document.getElementById("messageInput").addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                sendMessage();
            }
        });

        function sendMessage() {
            const messageInput = document.getElementById("messageInput");
            const message = messageInput.value.trim();
            if (message) {
                connection.invoke("SendMessageToSession", sessionId, message);
                messageInput.value = "";
            }
        }
    </script>
}