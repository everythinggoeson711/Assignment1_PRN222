@model FinalAssignment.Therapy.Core.Entities.ChatSession
@{
    ViewData["Title"] = $"Chat Session - {Model.CustomerName}";
    var messages = ViewBag.Messages as List<FinalAssignment.Therapy.Core.Entities.ChatMessage> ?? new List<FinalAssignment.Therapy.Core.Entities.ChatMessage>();
}

<section class="section-heading mb-4">
    <div class="d-flex justify-content-between align-items-center w-100">
        <div>
            <span class="eyebrow">Admin / Live Chat</span>
            <h1>Support Chat</h1>
            <p>Đang trò chuyện với: @(Model.CustomerName ?? "Unknown Customer")</p>
        </div>
        <div>
            <a href="@Url.Action("ChatSessions")" class="btn btn-outline-secondary btn-sm">
                ← Back to Inbox
            </a>
        </div>
    </div>
</section>

<div class="admin-chat-container glass-panel p-0 mb-4" style="overflow: hidden;">
    <!-- Chat Sidebar / Details -->
    <div class="chat-sidebar p-4 d-none d-lg-block">
        <div class="text-center mb-4">
            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <i class="fas fa-user"></i>
            </div>
            <h5 class="font-weight-bold text-gray-900 mb-1">@(Model.CustomerName ?? "Unknown")</h5>
            <p class="text-muted small">@Model.CustomerEmail</p>
            
            <div class="mt-3">
                <span class="badge badge-pill @(Model.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.WaitingForStaff ? "badge-warning" : Model.Status == FinalAssignment.Therapy.Core.Entities.ChatSessionStatus.Active ? "badge-success" : "badge-secondary") px-3 py-2">
                    @Model.Status
                </span>
            </div>
        </div>

        <hr class="sidebar-divider">

        <h6 class="font-weight-bold text-gray-800 mt-2 mb-3">Session Info</h6>
        <div class="small mb-3">
            <div class="text-muted">Started</div>
            <div class="font-weight-bold text-gray-800">@Model.StartedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
        </div>
        
        @if (Model.AssignedStaff != null)
        {
            <div class="small mb-3">
                <div class="text-muted">Assigned To</div>
                <div class="font-weight-bold text-primary">@Model.AssignedStaff.FullName</div>
            </div>
        }

        <hr class="sidebar-divider mt-auto">
        
        @if (Model.IsActive)
        {
            <form asp-action="EndChatSession" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="sessionId" value="@Model.SessionId" />
                <button type="submit" class="btn btn-outline-danger btn-block" onclick="return confirm('Are you sure you want to end this chat session?')">
                    End Session
                </button>
            </form>
        }
    </div>

    <!-- Main Chat Area -->
    <div class="chat-main">
        <!-- Chat Header -->
        <div class="p-3 border-bottom bg-white d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="d-lg-none mr-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
                <div>
                    <h6 class="m-0 font-weight-bold text-gray-900">@(Model.CustomerName ?? "Customer")</h6>
                    <small class="text-success"><i class="fas fa-circle" style="font-size: 0.5rem;"></i> Online</small>
                </div>
            </div>
            
            <div>
                @if (Model.AssignedStaffId == null && Model.IsActive)
                {
                    <button id="assignToMe" class="btn btn-sm btn-success shadow-sm">
                        <i class="fas fa-hand-paper mr-1"></i> Take Over
                    </button>
                }
            </div>
        </div>

        <!-- Messages Area -->
        <div class="chat-messages-area d-flex flex-column" id="messagesList">
            <div class="text-center mb-4">
                <span class="badge badge-pill badge-light px-3 py-2 text-muted border">Chat started at @Model.StartedAt.ToLocalTime().ToString("HH:mm")</span>
            </div>
            
            @foreach (var message in messages)
            {
                <div class="message-bubble @(message.IsFromStaff ? "message-staff" : "message-customer")">
                    <div style="white-space: pre-wrap;">@message.Message</div>
                    <div class="small text-right mt-1 @(message.IsFromStaff ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">
                        @message.SentAt.ToLocalTime().ToString("HH:mm")
                        @if (message.IsFromStaff)
                        {
                            <i class="fas fa-check-double ml-1"></i>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Input Area -->
        @if (Model.IsActive)
        {
            <div class="chat-input-area">
                <div class="chat-input-wrapper">
                    <input type="text" id="messageInput" placeholder="Type your message here..." @(Model.AssignedStaffId == null ? "disabled" : "") autocomplete="off" />
                    <button id="sendButton" class="chat-send-btn shadow-sm" @(Model.AssignedStaffId == null ? "disabled" : "")>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
                @if (Model.AssignedStaffId == null)
                {
                    <div class="text-center mt-2 small text-warning">
                        <i class="fas fa-exclamation-triangle"></i> You must take over this session to send messages.
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-3 bg-light text-center border-top text-muted font-italic">
                This chat session has ended.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const sessionId = "@Model.SessionId";
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .configureLogging(signalR.LogLevel.Information)
            .withAutomaticReconnect()
            .build();

        // Scroll to bottom immediately
        const messagesArea = document.getElementById("messagesList");
        if (messagesArea) {
            messagesArea.scrollTop = messagesArea.scrollHeight;
        }

        connection.on("ReceiveMessage", (messageData) => {
            const message = messageData.message || '[Empty]';
            const timestamp = messageData.timestamp || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            const isFromStaff = messageData.isFromStaff || false;
            
            const div = document.createElement("div");
            div.className = `message-bubble ${isFromStaff ? "message-staff" : "message-customer"}`;
            
            div.innerHTML = `
                <div style="white-space: pre-wrap;">${message}</div>
                <div class="small text-right mt-1 ${isFromStaff ? 'text-white-50' : 'text-muted'}" style="font-size: 0.7rem;">
                    ${timestamp} ${isFromStaff ? '<i class="fas fa-check-double ml-1"></i>' : ''}
                </div>
            `;
            
            if (messagesArea) {
                messagesArea.appendChild(div);
                messagesArea.scrollTop = messagesArea.scrollHeight;
            }
        });

        connection.on("groupTest", (msg) => {
            console.log("Admin Group Test:", msg);
        });

        connection.start().then(() => {
            connection.invoke("JoinAsStaff");
            connection.invoke("JoinSessionGroup", sessionId).then(() => {
                @if (Model.AssignedStaffId == null && Model.IsActive)
                {
                    <text>
                    setTimeout(() => {
                        connection.invoke("AssignToSession", sessionId).catch(err => console.error(err));
                    }, 1500);
                    </text>
                }
            });
        });

        connection.onreconnected(() => {
            connection.invoke("JoinAsStaff");
            connection.invoke("JoinSessionGroup", sessionId);
        });

        // Take Over Session
        const assignBtn = document.getElementById("assignToMe");
        if (assignBtn) {
            assignBtn.addEventListener("click", async () => {
                assignBtn.disabled = true;
                assignBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Assigning...';
                try {
                    await connection.invoke("AssignToSession", sessionId);
                    location.reload(); 
                } catch (err) {
                    console.error(err);
                    assignBtn.disabled = false;
                    assignBtn.innerHTML = '<i class="fas fa-hand-paper mr-1"></i> Take Over';
                }
            });
        }

        // Send message
        const sendBtn = document.getElementById("sendButton");
        const msgInput = document.getElementById("messageInput");
        
        if (sendBtn && msgInput) {
            sendBtn.addEventListener("click", sendMessage);
            msgInput.addEventListener("keypress", (e) => {
                if (e.key === "Enter") sendMessage();
            });

            function sendMessage() {
                const message = msgInput.value.trim();
                if (message) {
                    connection.invoke("SendMessageToSession", sessionId, message);
                    msgInput.value = "";
                }
            }
        }
    </script>
}