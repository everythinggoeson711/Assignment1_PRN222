@model FinalAssignment.Therapy.Application.Models.BookingServiceResult
@{
    ViewData["Title"] = "Thanh toán qua SePay";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-white text-center border-0 pt-4">
                    <h4 class="fw-bold">Quét mã để thanh toán</h4>
                    <p class="text-muted small">Vui lòng sử dụng ứng dụng Ngân hàng để quét mã VietQR bên dưới</p>
                </div>
                <div class="card-body text-center px-4">
                    <div class="mb-4">
                        <img src="@Model.QrCodeUrl" alt="VietQR" class="img-fluid rounded shadow-sm border" style="max-width: 300px;" />
                    </div>
                    
                    <div class="alert alert-info text-start mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Số tiền:</span>
                            <strong class="text-primary">@Model.Amount.ToString("N0") VND</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Nội dung chuyển khoản:</span>
                            <strong class="text-danger">@Model.TrackingCode</strong>
                        </div>
                        <hr />
                        <p class="mb-0 xsmall text-muted">
                            <i class="fas fa-info-circle me-1"></i> 
                            Hệ thống sẽ tự động xác nhận lịch hẹn ngay sau khi nhận được tiền (thường từ 30s - 2 phút).
                        </p>
                    </div>

                    <div class="d-grid gap-2">
                        <form asp-action="ConfirmPayment" asp-controller="Booking" method="post" class="d-grid">
                            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                            <button type="submit" class="btn btn-success mb-2">
                                <i class="fas fa-check-circle me-2"></i>Giả lập Thanh toán Thành công
                            </button>
                        </form>
                        <a href="/" class="btn btn-outline-secondary">Quay lại trang chủ</a>
                        <p class="mt-3 small text-muted">Bạn có thể đóng trang này sau khi thanh toán thành công.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
