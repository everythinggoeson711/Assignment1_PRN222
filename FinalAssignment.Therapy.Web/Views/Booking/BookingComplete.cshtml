@model FinalAssignment.Therapy.Application.Models.AppointmentSummaryDto
@{
    ViewData["Title"] = "Booking Complete";
    bool isConfirmed = Model.Status == FinalAssignment.Therapy.Core.Enums.AppointmentStatus.Confirmed;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                @if (isConfirmed)
                {
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 100px; height: 100px;">
                        <i class="fas fa-check fa-3x"></i>
                    </div>
                    <h1 class="display-5 fw-bold">Booking Confirmed!</h1>
                    <p class="lead text-muted">Your session with <strong>@Model.TherapistName</strong> has been successfully scheduled.</p>
                }
                else
                {
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 100px; height: 100px;">
                        <i class="fas fa-clock fa-3x"></i>
                    </div>
                    <h1 class="display-5 fw-bold">Booking Received</h1>
                    <p class="lead text-muted">Your appointment is pending payment. Please finalize it to secure your slot.</p>
                }
            </div>

            <div class="glass-panel p-5 border-0 shadow-lg mb-5" style="border-radius: 30px;">
                <div class="row align-items-center mb-4">
                    <div class="col">
                        <h4 class="fw-bold mb-0">Booking Summary</h4>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-@(isConfirmed ? "success" : "warning") rounded-pill px-3 py-2">
                            Status: @Model.Status
                        </span>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-4 bg-light rounded-4 h-100">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Service</label>
                            <h5 class="fw-bold mb-0">@Model.ServiceName</h5>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-4 bg-light rounded-4 h-100">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Date & Time</label>
                            <h5 class="fw-bold mb-0">@Model.AppointmentStartUtc.ToLocalTime().ToString("f")</h5>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-4 bg-light rounded-4 h-100">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Therapist</label>
                            <h5 class="fw-bold mb-0">@Model.TherapistName</h5>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-4 bg-light rounded-4 h-100">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Tracking Code</label>
                            <h5 class="fw-bold mb-0">@Model.TrackingCode</h5>
                        </div>
                    </div>
                </div>

                <div class="mt-5 p-4 bg-primary bg-opacity-5 rounded-4 border border-primary border-opacity-10">
                    <h6 class="fw-bold text-primary mb-2"><i class="fas fa-info-circle me-2"></i> What's Next?</h6>
                    <p class="text-muted small mb-0">
                        A confirmation email has been sent to <strong>@Model.PatientEmail</strong>. 
                        You can use your tracking code to manage your appointment or contact support if you need to reschedule.
                    </p>
                </div>
            </div>

            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-lg">
                    <i class="fas fa-home me-2"></i> Return to Home
                </a>
            </div>
        </div>
    </div>
</div>
