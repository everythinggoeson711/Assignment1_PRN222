<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Final Therapy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinalAssignment.Therapy.Web.styles.css" asp-append-version="true" />
    <style>
        :root { --sidebar-bg: #1a2f4b; --accent: #2ecc71; }
        body { background: #f0f4f8; font-family: 'Segoe UI', sans-serif; }
        .sidebar { width: 250px; min-height: 100vh; background: var(--sidebar-bg); position: fixed; top: 0; left: 0; z-index: 100; display: flex; flex-direction: column; }
        .sidebar-brand { padding: 24px 20px 16px; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar-brand h5 { color: var(--accent); font-weight: 700; margin: 0; font-size: 1.1rem; }
        .sidebar-brand small { color: #aab7c4; font-size: .75rem; }
        .sidebar .nav-link { color: #aab7c4; padding: 10px 20px; border-radius: 6px; margin: 2px 10px; transition: all .2s; font-size: .88rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(46,204,113,.15); color: var(--accent); }
        .sidebar .nav-link i { margin-right: 8px; width: 18px; text-align: center; }
        .sidebar-footer { margin-top: auto; padding: 16px 20px; border-top: 1px solid rgba(255,255,255,.1); }
        .main-content { margin-left: 250px; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #dee2e6; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; }
        .topbar .page-title { font-weight: 600; font-size: 1.1rem; color: #1a2f4b; margin: 0; }
        .page-wrapper { padding: 24px; }
        .card { border: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); border-radius: 10px; }
        .card-header { background: #fff; border-bottom: 1px solid #f0f0f0; font-weight: 600; }
        .stat-card { border-radius: 12px; color: #fff; padding: 20px; }
        .stat-card .stat-icon { font-size: 2rem; opacity: .8; }
        .stat-card .stat-value { font-size: 1.8rem; font-weight: 700; }
        .stat-card .stat-label { opacity: .85; font-size: .85rem; }
        .badge-pending { background: #fff3cd; color: #856404; }
        .badge-confirmed { background: #cff4fc; color: #055160; }
        .badge-completed { background: #d1e7dd; color: #0a3622; }
        .badge-cancelled { background: #f8d7da; color: #842029; }
        .auth-wrapper { min-height: 100vh; background: linear-gradient(135deg, #1a2f4b 0%, #2ecc71 100%); display: flex; align-items: center; justify-content: center; margin-left: 0 !important; }
        .auth-card { background: #fff; border-radius: 16px; padding: 40px; width: 400px; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
    </style>
</head>
@{
    bool isAuth = User.Identity?.IsAuthenticated == true;
    bool isLogin = ViewContext.RouteData.Values["controller"]?.ToString() == "Auth";
    bool isPublic = !isAuth && !isLogin;
    bool isAdmin = User.IsInRole("Admin");
    bool isTherapist = User.IsInRole("Therapist");
}
<body class="@(isAuth && !isLogin ? "app-shell" : isPublic ? "public-shell" : "login-shell")">

@if (isAuth && !isLogin)
{
    <div class="sidebar">
        <div class="sidebar-brand">
            <h5>🧠 Final Therapy</h5>
            <small>@(isAdmin ? "Admin" : isTherapist ? "Therapist" : "User")</small>
        </div>
        <nav class="nav flex-column pt-2">
            @if (isAdmin)
            {
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                    📊 Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Therapist") == true ? "active" : "")" asp-controller="Admin" asp-action="Therapists">
                    👥 Therapists
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Service") == true ? "active" : "")" asp-controller="Admin" asp-action="Services">
                    🩺 Services
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Schedule" ? "active" : "")" asp-controller="Schedule" asp-action="Calendar">
                    📅 Doctor Schedule
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ChatSessions" ? "active" : "")" asp-controller="Admin" asp-action="ChatSessions">
                    💬 Chat Support
                </a>
            }
            else if (isTherapist)
            {
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyAppointments" ? "active" : "")" asp-controller="Therapist" asp-action="MyAppointments">
                    📅 My Appointments
                </a>
            }
            <a href="#" class="nav-link" onclick="document.getElementById('fc-bubble').click(); return false;">
                💬 Live Support
            </a>
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                🌐 Public Home
            </a>
        </nav>
        <div class="sidebar-footer">
            <div class="text-white-50 small mb-2">👤 @User.Identity?.Name</div>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Logout</button>
            </form>
        </div>
    </div>
    <div class="main-content">
        <div class="topbar">
            <h6 class="page-title">@ViewData["Title"]</h6>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible py-1 px-3 mb-0 fade show" role="alert">
                    ✅ @TempData["Success"]
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible py-1 px-3 mb-0 fade show" role="alert">
                    ❌ @TempData["Error"]
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
        <div class="page-wrapper">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>
}
else if(isLogin)
{
    <main role="main">
        @RenderBody()
    </main>
}
else
{
    <div class="container">
        <header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 mb-4 border-bottom">
            <a href="/" class="d-flex align-items-center col-md-3 mb-2 mb-md-0 text-dark text-decoration-none">
                <h5 class="mb-0">🧠 Final Therapy</h5>
            </a>

            <ul class="nav col-12 col-md-auto mb-2 justify-content-center mb-md-0">
                <li><a asp-controller="Home" asp-action="Index" class="nav-link px-2 link-secondary">Overview</a></li>
                <li><a asp-controller="Booking" asp-action="Create" class="nav-link px-2 link-dark">Book Session</a></li>
                <li><a href="#" class="nav-link px-2 link-dark" onclick="document.getElementById('fc-bubble').click(); return false;">Live Support</a></li>
            </ul>

            <div class="col-md-3 text-end">
                <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary me-2">Login</a>
            </div>
        </header>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible py-2 px-3 mb-3 fade show" role="alert">
                    ✅ @TempData["Success"]
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible py-2 px-3 mb-3 fade show" role="alert">
                    ❌ @TempData["Error"]
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
}

<partial name="_FloatingChatWidget" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
