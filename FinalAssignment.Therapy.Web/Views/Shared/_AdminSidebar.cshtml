@* Admin sidebar — rendered inside admin layout panels *@
<nav class="admin-sidebar d-flex flex-column gap-2 p-3">
    <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
       asp-controller="Admin" asp-action="Dashboard">
        <span>Dashboard</span>
    </a>
    <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Therapists" ? "active" : "")"
       asp-controller="Admin" asp-action="Therapists">
        <span>Therapists</span>
    </a>
    <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")"
       asp-controller="Admin" asp-action="Services">
        <span>Services</span>
    </a>
    <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ChatSessions" ? "active" : "")"
       asp-controller="Admin" asp-action="ChatSessions">
        <span>Chat Support</span>
    </a>
    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Schedule" ? "active" : "")"
       asp-controller="Schedule" asp-action="Calendar">
        <span>Doctor Schedule</span>
    </a>
</nav>
