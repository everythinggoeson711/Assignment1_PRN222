@model Assigment2_therapy.Models.ViewModels.TherapistFormViewModel
@{
    ViewData["Title"] = "Thêm Chuyên gia mới";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">👤 Thông tin chuyên gia</div>
            <div class="card-body">
                <form asp-action="CreateTherapist" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Specialty" class="form-label fw-semibold"></label>
                            <input asp-for="Specialty" class="form-control" placeholder="Trầm cảm, Lo âu..." />
                            <span asp-validation-for="Specialty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="09xxxxxxxx" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IsActive" class="form-label fw-semibold"></label>
                            <select asp-for="IsActive" class="form-select">
                                <option value="true">Đang hoạt động</option>
                                <option value="false">Tạm dừng</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Giới thiệu ngắn..."></textarea>
                        </div>
                        <div class="col-12"><hr /><h6 class="text-muted">🔐 Tài khoản đăng nhập</h6></div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="therapist@montra.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Mật khẩu" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success">💾 Lưu</button>
                        <a asp-action="Therapists" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
