@model List<TherapyService>
@{
    ViewData["Title"] = "Quản lý Dịch vụ";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>🩺 Danh sách dịch vụ (@Model.Count)</span>
        <a asp-action="CreateService" class="btn btn-success btn-sm">+ Thêm mới</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Tên dịch vụ</th>
                        <th>Mô tả</th>
                        <th>Giá</th>
                        <th>Thời lượng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td class="fw-semibold">@s.Name</td>
                            <td class="text-muted small">@s.Description</td>
                            <td class="fw-semibold text-success">@s.Price.ToString("N0")đ</td>
                            <td>@s.DurationMinutes phút</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm dừng</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="EditService" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-primary">Sửa</a>
                                <form asp-action="DeleteService" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa dịch vụ «@s.Name»?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có dịch vụ nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
