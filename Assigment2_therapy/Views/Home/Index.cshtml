@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const serviceSelect = document.getElementById('booking-service');
            const therapistSelect = document.getElementById('booking-therapist');
            const dateInput = document.getElementById('booking-date');
            const slotSelect = document.getElementById('booking-timeslot');
            const statusEl = document.getElementById('booking-availability-status');
            const submitBtn = document.getElementById('booking-submit-btn');
            const titleEl = document.getElementById('booking-summary-title');
            const priceEl = document.getElementById('booking-summary-price');
            const durationEl = document.getElementById('booking-summary-duration');

            if (!serviceSelect || !therapistSelect || !dateInput || !slotSelect || !statusEl || !submitBtn) {
                return;
            }

            function updateSummary() {
                if (serviceSelect.options.length === 0) {
                    titleEl.textContent = 'No live service configured';
                    priceEl.textContent = '0 VND';
                    durationEl.textContent = '0 mins';
                    return;
                }

                const selected = serviceSelect.options[serviceSelect.selectedIndex];
                titleEl.textContent = selected.textContent;
                const price = Number(selected.dataset.price || '0');
                const duration = selected.dataset.duration || '0';
                priceEl.textContent = `${price.toLocaleString('vi-VN')} VND`;
                durationEl.textContent = `${duration} mins`;
            }

            let controller;

            async function checkAvailability() {
                updateSummary();

                if (!therapistSelect.value || !dateInput.value || !slotSelect.value) {
                    statusEl.textContent = 'Choose clinician, date and time slot to validate availability.';
                    statusEl.className = 'public-booking-status';
                    submitBtn.disabled = true;
                    return;
                }

                if (controller) {
                    controller.abort();
                }

                controller = new AbortController();
                statusEl.textContent = 'Checking availability in realtime...';
                statusEl.className = 'public-booking-status';
                submitBtn.disabled = true;

                const params = new URLSearchParams({
                    therapistId: therapistSelect.value,
                    appointmentDate: dateInput.value,
                    timeSlot: slotSelect.value
                });

                try {
                    const response = await fetch(`/Home/CheckAvailability?${params.toString()}`, { signal: controller.signal });
                    const data = await response.json();
                    statusEl.textContent = data.message;
                    statusEl.className = data.available ? 'public-booking-status is-available' : 'public-booking-status is-unavailable';
                    submitBtn.disabled = !data.available;
                } catch (error) {
                    if (error.name === 'AbortError') {
                        return;
                    }

                    statusEl.textContent = 'Could not validate availability right now. Please try again.';
                    statusEl.className = 'public-booking-status is-unavailable';
                    submitBtn.disabled = true;
                }
            }

            [serviceSelect, therapistSelect, dateInput, slotSelect].forEach(element => {
                element.addEventListener('change', checkAvailability);
            });

            updateSummary();
            checkAvailability();
        })();
    </script>
}
