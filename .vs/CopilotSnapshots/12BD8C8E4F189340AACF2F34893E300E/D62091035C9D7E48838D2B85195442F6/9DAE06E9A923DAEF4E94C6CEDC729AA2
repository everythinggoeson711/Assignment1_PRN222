using System.Windows;
using System.Windows.Input;
using ChatClient.Services;
using ChatClient.Models;

namespace ChatClient.Views
{
    public partial class MainWindow : Window
    {
        private ChatService chatService;
        private bool isConnected = false;

        public MainWindow()
        {
            InitializeComponent();
            chatService = new ChatService();

            // Subscribe to events
            chatService.MessageReceived += OnMessageReceived;
            chatService.Disconnected += OnDisconnected;
            chatService.ConnectionError += OnConnectionError;
        }

        private async void BtnConnect_Click(object sender, RoutedEventArgs e)
        {
            if (!isConnected)
            {
                // Validate inputs
                if (string.IsNullOrWhiteSpace(txtServerIp.Text))
                {
                    MessageBox.Show("Please enter server IP address.", "Validation Error", 
                        MessageBoxButton.OK, MessageBoxImage.Warning);
                    return;
                }

                if (!int.TryParse(txtPort.Text, out int port))
                {
                    MessageBox.Show("Please enter a valid port number.", "Validation Error", 
                        MessageBoxButton.OK, MessageBoxImage.Warning);
                    return;
                }

                if (string.IsNullOrWhiteSpace(txtUsername.Text))
                {
                    MessageBox.Show("Please enter a username.", "Validation Error", 
                        MessageBoxButton.OK, MessageBoxImage.Warning);
                    return;
                }

                // Disable connection controls
                btnConnect.IsEnabled = false;
                btnConnect.Content = "Connecting...";

                bool success = await chatService.ConnectAsync(txtServerIp.Text, port, txtUsername.Text);

                if (success)
                {
                    isConnected = true;
                    btnConnect.Content = "Disconnect";
                    btnConnect.Background = System.Windows.Media.Brushes.Red;
                    btnConnect.IsEnabled = true;

                    // Enable message controls
                    txtMessage.IsEnabled = true;
                    btnSend.IsEnabled = true;

                    // Disable connection settings
                    txtServerIp.IsEnabled = false;
                    txtPort.IsEnabled = false;
                    txtUsername.IsEnabled = false;

                    AddSystemMessage("Connected to server successfully!");
                    txtMessage.Focus();
                }
                else
                {
                    btnConnect.IsEnabled = true;
                    btnConnect.Content = "Connect";
                }
            }
            else
            {
                // Disconnect
                chatService.Disconnect();
            }
        }

        private async void BtnSend_Click(object sender, RoutedEventArgs e)
        {
            await SendMessage();
        }

        private async void TxtMessage_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter)
            {
                await SendMessage();
            }
        }

        private async Task SendMessage()
        {
            string message = txtMessage.Text.Trim();
            if (string.IsNullOrEmpty(message))
            {
                return;
            }

            try
            {
                await chatService.SendMessageAsync(message);
                txtMessage.Clear();
                txtMessage.Focus();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Failed to send message: {ex.Message}", "Error", 
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void OnMessageReceived(string message)
        {
            // Use Dispatcher to update UI from background thread
            Application.Current.Dispatcher.Invoke(() =>
            {
                var chatMessage = new ChatMessage("", message);
                lstMessages.Items.Add(chatMessage.ToString());

                // Auto-scroll to bottom
                if (lstMessages.Items.Count > 0)
                {
                    lstMessages.ScrollIntoView(lstMessages.Items[lstMessages.Items.Count - 1]);
                }
            });
        }

        private void OnDisconnected()
        {
            Application.Current.Dispatcher.Invoke(() =>
            {
                isConnected = false;
                btnConnect.Content = "Connect";
                btnConnect.Background = System.Windows.Media.Brushes.Green;
                btnConnect.IsEnabled = true;

                // Disable message controls
                txtMessage.IsEnabled = false;
                btnSend.IsEnabled = false;

                // Enable connection settings
                txtServerIp.IsEnabled = true;
                txtPort.IsEnabled = true;
                txtUsername.IsEnabled = true;

                AddSystemMessage("Disconnected from server.");
            });
        }

        private void OnConnectionError(string error)
        {
            Application.Current.Dispatcher.Invoke(() =>
            {
                MessageBox.Show(error, "Connection Error", MessageBoxButton.OK, MessageBoxImage.Error);
            });
        }

        private void AddSystemMessage(string message)
        {
            var systemMessage = new ChatMessage("System", $"[System] {message}", true);
            lstMessages.Items.Add(systemMessage.ToString());

            if (lstMessages.Items.Count > 0)
            {
                lstMessages.ScrollIntoView(lstMessages.Items[lstMessages.Items.Count - 1]);
            }
        }

        private void Window_Closing(object sender, System.ComponentModel.CancelEventArgs e)
        {
            chatService.Disconnect();
        }
    }
}
