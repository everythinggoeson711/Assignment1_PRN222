<Window x:Class="ChatClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatClient.Views"
        mc:Ignorable="d"
        Title="Telegram Desktop" Height="700" Width="450"
        Closing="Window_Closing"
        Background="{StaticResource TelegramBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:MessageAlignmentConverter x:Key="AlignmentConverter" />
        <local:MessageColorConverter x:Key="ColorConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Avatar for others -->
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource TelegramPrimary}" 
                        VerticalAlignment="Bottom" Margin="0,0,8,0"
                        Visibility="{Binding IsOwnMessage, ConverterParameter=Inverse, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding AvatarInitial}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <!-- Message Bubble -->
                <StackPanel Grid.Column="1" HorizontalAlignment="{Binding IsOwnMessage, Converter={StaticResource AlignmentConverter}}">
                    <Border CornerRadius="10" Padding="10,5" 
                            Background="{Binding IsOwnMessage, Converter={StaticResource ColorConverter}}"
                            MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="{Binding Username}" Foreground="{StaticResource TelegramPrimary}" FontWeight="Bold" FontSize="12" 
                                       Visibility="{Binding IsOwnMessage, ConverterParameter=Inverse, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TelegramText}"/>
                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="10" Foreground="{StaticResource TelegramSubText}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat Header (Telegram Style) -->
        <Border Grid.Row="0" Background="{StaticResource TelegramSecondary}" Padding="15,10" BorderBrush="#ddd" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{StaticResource TelegramPrimary}" Margin="0,0,15,0" Effect="{StaticResource MessageShadow}">
                    <TextBlock Text="💬" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="22"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="lblChatTitle" Text="Public Chat" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TelegramText}"/>
                    <TextBlock x:Name="lblStatus" Text="Online" FontSize="12" Foreground="{StaticResource TelegramPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernIconButton}" Margin="0,0,15,0">
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TelegramSubText}" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ModernIconButton}">
                        <Path Data="{StaticResource IconMore}" Fill="{StaticResource TelegramSubText}" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Display Area (unchanged) -->
        <ListBox Grid.Row="1" x:Name="lstMessages" 
                 Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource ChatMessageTemplate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Message Input Panel -->
        <Border Grid.Row="2" Background="White" Padding="10,8" BorderBrush="#ddd" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ModernIconButton}" Margin="0,0,10,0">
                    <Path Data="{StaticResource IconAttach}" Fill="{StaticResource TelegramSubText}" Width="22" Height="22" Stretch="Uniform"/>
                </Button>

                <TextBox Grid.Column="1" x:Name="txtMessage" 
                         Margin="0,0,10,0" BorderThickness="0"
                         VerticalAlignment="Center" Padding="5,8"
                         IsEnabled="True"
                         KeyDown="TxtMessage_KeyDown"
                         FontSize="15" AcceptsReturn="False"/>

                <Button Grid.Column="2" Style="{StaticResource ModernIconButton}" Margin="0,0,10,0">
                    <Path Data="{StaticResource IconEmoji}" Fill="{StaticResource TelegramSubText}" Width="22" Height="22" Stretch="Uniform"/>
                </Button>

                <Button Grid.Column="3" x:Name="btnSend" 
                        Click="BtnSend_Click"
                        IsEnabled="True" Width="40" Height="40"
                        Style="{StaticResource ModernIconButton}" Background="Transparent">
                    <Path Data="{StaticResource IconSend}" Fill="{StaticResource TelegramPrimary}" Width="24" Height="24" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
