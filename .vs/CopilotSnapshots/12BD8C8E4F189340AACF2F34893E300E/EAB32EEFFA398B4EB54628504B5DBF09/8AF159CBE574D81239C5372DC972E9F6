<Window x:Class="ChatClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chat App - Zalo Style" Height="700" Width="900"
        Closing="Window_Closing"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Chat Message Item Template -->
        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Other User's Message (Left side) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                           HorizontalAlignment="Left"
                           Visibility="{Binding IsOwnMessage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <!-- Avatar -->
                    <Border Width="36" Height="36" CornerRadius="18" 
                           Background="#0068FF" Margin="5,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding AvatarInitial}" 
                                  Foreground="White" FontWeight="Bold" 
                                  FontSize="16" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Message Bubble -->
                    <StackPanel MaxWidth="450">
                        <TextBlock Text="{Binding Username}" 
                                  FontSize="12" 
                                  Foreground="#666666" 
                                  Margin="0,0,0,3"
                                  FontWeight="SemiBold"/>
                        <Border Background="White" 
                               CornerRadius="12,12,12,3" 
                               Padding="12,8"
                               Effect="{StaticResource MessageShadow}">
                            <TextBlock Text="{Binding Content}" 
                                      TextWrapping="Wrap" 
                                      FontSize="14"
                                      Foreground="#333333"/>
                        </Border>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                                  FontSize="11" 
                                  Foreground="#999999" 
                                  Margin="5,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Own Message (Right side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsOwnMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Message Bubble -->
                    <StackPanel MaxWidth="450">
                        <Border Background="#0068FF" 
                               CornerRadius="12,12,3,12" 
                               Padding="12,8"
                               Effect="{StaticResource MessageShadow}">
                            <TextBlock Text="{Binding Content}" 
                                      TextWrapping="Wrap" 
                                      FontSize="14"
                                      Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                                  FontSize="11" 
                                  Foreground="#999999" 
                                  Margin="0,2,5,0"
                                  HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Avatar -->
                    <Border Width="36" Height="36" CornerRadius="18" 
                           Background="#00C853" Margin="10,0,5,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding AvatarInitial}" 
                                  Foreground="White" FontWeight="Bold" 
                                  FontSize="16" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- System Message (Center) -->
                <Border Grid.Column="1" 
                       Background="#E8E8E8" 
                       CornerRadius="12" 
                       Padding="10,5"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsSystemMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding Content}" 
                              FontSize="12" 
                              Foreground="#666666"
                              TextAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="MessageShadow" 
                         BlurRadius="8" 
                         ShadowDepth="2" 
                         Opacity="0.15" 
                         Color="#000000"/>

        <!-- Bool to Visibility Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="InverseBoolToVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Connection Panel -->
        <Border Grid.Row="0" Background="White" Padding="15,12" 
               Effect="{StaticResource MessageShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🌐 Server:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,8,0"
                          FontWeight="SemiBold"
                          Foreground="#333333"/>
                <TextBox Grid.Column="1" x:Name="txtServerIp" 
                        Text="127.0.0.1" 
                        Margin="0,0,15,0" 
                        VerticalAlignment="Center"
                        Style="{StaticResource ModernTextBox}"
                        MaxWidth="150"/>

                <TextBlock Grid.Column="2" Text="Port:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,8,0"
                          FontWeight="SemiBold"
                          Foreground="#333333"/>
                <TextBox Grid.Column="3" x:Name="txtPort" 
                        Text="8888" 
                        Width="70" 
                        Margin="0,0,15,0" 
                        VerticalAlignment="Center"
                        Style="{StaticResource ModernTextBox}"/>

                <TextBlock Grid.Column="4" Text="👤 Username:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,8,0"
                          FontWeight="SemiBold"
                          Foreground="#333333"/>
                <TextBox Grid.Column="5" x:Name="txtUsername" 
                        Text="User" 
                        Margin="0,0,15,0" 
                        VerticalAlignment="Center"
                        Style="{StaticResource ModernTextBox}"
                        MaxWidth="150"/>

                <Button Grid.Column="6" x:Name="btnConnect" 
                       Content="Kết nối" 
                       Width="110" 
                       Height="36"
                       Click="BtnConnect_Click" 
                       Style="{StaticResource ModernButton}"/>
            </Grid>
        </Border>

        <!-- Chat Display Area -->
        <Border Grid.Row="1" Background="#F0F2F5" Margin="0">
            <Grid>
                <!-- Background pattern (optional) -->
                <Rectangle Fill="#F0F2F5" Opacity="0.5"/>

                <ListBox x:Name="lstMessages" 
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemTemplate="{StaticResource ChatMessageTemplate}"
                        Padding="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Message Input Panel -->
        <Border Grid.Row="2" Background="White" 
               Padding="15,12"
               Effect="{StaticResource MessageShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Emoji Button (optional decoration) -->
                <Button Grid.Column="0" 
                       Content="😊" 
                       Width="40" 
                       Height="40"
                       Margin="0,0,10,0"
                       Background="Transparent"
                       BorderThickness="0"
                       FontSize="20"
                       Cursor="Hand"
                       ToolTip="Emoji"/>

                <!-- Message Input -->
                <Border Grid.Column="1" 
                       Background="#F0F2F5" 
                       CornerRadius="20"
                       Padding="2">
                    <TextBox x:Name="txtMessage" 
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="15,8"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            KeyDown="TxtMessage_KeyDown"
                            FontSize="14"
                            TextWrapping="Wrap"
                            MaxHeight="100"
                            VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Send Button -->
                <Button Grid.Column="2" x:Name="btnSend" 
                       Content="✈️ Gửi" 
                       Width="90" 
                       Height="40"
                       Margin="10,0,0,0"
                       Click="BtnSend_Click"
                       IsEnabled="False"
                       Style="{StaticResource ModernButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
