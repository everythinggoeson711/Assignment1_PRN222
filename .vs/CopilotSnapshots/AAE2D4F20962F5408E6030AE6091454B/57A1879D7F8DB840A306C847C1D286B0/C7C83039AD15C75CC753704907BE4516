@model AppointmentListViewModel
@{
    ViewData["Title"] = "Quản lý Lịch hẹn";
}


<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">🔍 Bệnh nhân</label>
                <input type="text" name="patientName" value="@Model.PatientName"
                       class="form-control" placeholder="Tên bệnh nhân..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">👤 Chuyên gia</label>
                <select name="therapistId" class="form-select">
                    <option value="">-- Tất cả --</option>
                    @foreach (var t in Model.Therapists)
                    {
                        <option value="@t.Id" selected="@(Model.TherapistId == t.Id)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">📌 Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="0" selected="@(Model.Status == AppointmentStatus.Pending)">Chờ xác nhận</option>
                    <option value="1" selected="@(Model.Status == AppointmentStatus.Confirmed)">Đã xác nhận</option>
                    <option value="2" selected="@(Model.Status == AppointmentStatus.Completed)">Hoàn tất</option>
                    <option value="3" selected="@(Model.Status == AppointmentStatus.Cancelled)">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">📅 Ngày</label>
                <input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-fill">Lọc</button>
                <a asp-action="Appointments" class="btn btn-outline-secondary">↺</a>
            </div>
        </form>
    </div>
</div>


<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>📅 Kết quả: <strong>@Model.Appointments.Count</strong> lịch hẹn</span>
        <a asp-action="CreateAppointment" class="btn btn-success btn-sm">+ Đặt lịch mới</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Bệnh nhân</th>
                        <th>Chuyên gia</th>
                        <th>Dịch vụ</th>
                        <th>Ngày hẹn</th>
                        <th>Khung giờ</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments)
                    {
                        @{
                            var (badgeCls, badgeLbl) = a.Status switch
                            {
                                AppointmentStatus.Pending   => ("badge-pending",   "Chờ xác nhận"),
                                AppointmentStatus.Confirmed => ("badge-confirmed", "Đã xác nhận"),
                                AppointmentStatus.Completed => ("badge-completed", "Hoàn tất"),
                                _                           => ("badge-cancelled", "Đã hủy")
                            };
                        }
                        <tr>
                            <td class="text-muted small">@a.Id</td>
                            <td>
                                <div class="fw-semibold">@a.PatientName</div>
                                <div class="text-muted small">@a.PatientPhone</div>
                            </td>
                            <td>@a.Therapist?.Name</td>
                            <td>
                                <div>@a.Service?.Name</div>
                                <div class="text-muted small">@a.Service?.Price.ToString("N0")đ</div>
                            </td>
                            <td>@a.AppointmentDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-light text-dark border">@a.TimeSlot</span></td>
                            <td><span class="badge @badgeCls">@badgeLbl</span></td>
                            <td class="text-end">
                                <form asp-action="DeleteAppointment" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa lịch hẹn của @a.PatientName?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Appointments.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                Không tìm thấy lịch hẹn nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

