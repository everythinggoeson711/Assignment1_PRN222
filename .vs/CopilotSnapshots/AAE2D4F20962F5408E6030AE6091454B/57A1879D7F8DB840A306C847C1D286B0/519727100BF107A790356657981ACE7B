@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Báo cáo thống kê";
}


<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#667eea,#764ba2)">
            <div class="stat-icon">👥</div>
            <div class="stat-value">@Model.TotalTherapists</div>
            <div class="stat-label">Tổng chuyên gia</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#f093fb,#f5576c)">
            <div class="stat-icon">📅</div>
            <div class="stat-value">@Model.TotalAppointments</div>
            <div class="stat-label">Tổng lịch hẹn</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
            <div class="stat-icon">✅</div>
            <div class="stat-value">@Model.CompletedAppointments</div>
            <div class="stat-label">Đã hoàn tất</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#43e97b,#38f9d7)">
            <div class="stat-icon">💰</div>
            <div class="stat-value">@Model.TotalRevenue.ToString("N0")đ</div>
            <div class="stat-label">Doanh thu</div>
        </div>
    </div>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">📊 Phân bổ trạng thái lịch hẹn</div>
            <div class="card-body">
                @{
                    var pending   = Model.RecentAppointments.Count(a => a.Status == AppointmentStatus.Pending);
                    var confirmed = Model.RecentAppointments.Count(a => a.Status == AppointmentStatus.Confirmed);
                    var completed = Model.RecentAppointments.Count(a => a.Status == AppointmentStatus.Completed);
                    var cancelled = Model.RecentAppointments.Count(a => a.Status == AppointmentStatus.Cancelled);
                    var total     = Model.TotalAppointments > 0 ? Model.TotalAppointments : 1;
                }
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>⏳ Chờ xác nhận</span><strong>@pending</strong>
                    </div>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar bg-warning" style="width:@(pending * 100 / total)%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>📋 Đã xác nhận</span><strong>@confirmed</strong>
                    </div>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar bg-info" style="width:@(confirmed * 100 / total)%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>✅ Hoàn tất</span><strong>@completed</strong>
                    </div>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar bg-success" style="width:@(completed * 100 / total)%"></div>
                    </div>
                </div>
                <div class="mb-0">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>❌ Đã hủy</span><strong>@cancelled</strong>
                    </div>
                    <div class="progress" style="height:8px">
                        <div class="progress-bar bg-danger" style="width:@(cancelled * 100 / total)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">🏆 Chuyên gia có nhiều lịch nhất</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Chuyên gia</th><th class="text-end">Số lịch</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var grp in Model.RecentAppointments
                            .GroupBy(a => a.Therapist?.Name ?? "—")
                            .OrderByDescending(g => g.Count())
                            .Take(5))
                        {
                            <tr>
                                <td>@grp.Key</td>
                                <td class="text-end fw-semibold">@grp.Count()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header">📋 Toàn bộ lịch hẹn (@Model.RecentAppointments.Count)</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Bệnh nhân</th>
                        <th>Chuyên gia</th>
                        <th>Dịch vụ</th>
                        <th>Ngày hẹn</th>
                        <th>Doanh thu</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.RecentAppointments)
                    {
                        @{
                            var (badgeCls, badgeLbl) = a.Status switch
                            {
                                AppointmentStatus.Pending   => ("badge-pending",   "Chờ xác nhận"),
                                AppointmentStatus.Confirmed => ("badge-confirmed", "Đã xác nhận"),
                                AppointmentStatus.Completed => ("badge-completed", "Hoàn tất"),
                                _                           => ("badge-cancelled", "Đã hủy")
                            };
                        }
                        <tr>
                            <td>@a.PatientName</td>
                            <td>@a.Therapist?.Name</td>
                            <td>@a.Service?.Name</td>
                            <td>@a.AppointmentDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (a.Status == AppointmentStatus.Completed)
                                {
                                    <span class="text-success fw-semibold">@a.Service?.Price.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @badgeCls">@badgeLbl</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

